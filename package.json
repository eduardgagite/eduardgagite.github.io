{
  "name": "eduardgagite.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:assets": "node scripts/generate-static-assets.mjs",
    "dev": "npm run generate:assets && node scripts/generate-materials-json.mjs && node scripts/generate-sitemap.mjs && vite",
    "build": "npm run generate:assets && node scripts/generate-materials-json.mjs && node scripts/generate-sitemap.mjs && tsc -b && vite build && node scripts/generate-route-shells.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "lint": "npm run typecheck && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test scripts/tests/*.test.mjs scripts/tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "i18next": "^23.11.5",
    "i18next-browser-languagedetector": "^8.0.5",
    "prism-react-renderer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.15",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
